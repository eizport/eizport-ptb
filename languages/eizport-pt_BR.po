msgid "Give the names of the copies to delete, or \"all\"."
msgstr "Informe os nomes das cópias a excluir, ou \"all\"."

#: includes/abilities.php:1200
msgid "There is no such copy: see eizport/get-copies."
msgstr "Essa cópia não existe: veja o eizport/get-copies."

#: includes/abilities.php:1207
msgid "The attachment is not a .wxrz, .zip, .xml or .xml.gz file."
msgstr "O anexo não é um arquivo .wxrz, .zip, .xml ou .xml.gz."

#: includes/abilities.php:1212
msgid "Give a \"copy\" name or an \"attachment_id\" to import."
msgstr "Informe um nome em \"copy\" ou um \"attachment_id\" para importar."

#: includes/abilities.php:1225
msgid ""
"This .zip is a plugin: install it in Plugins → Add Plugin → Upload Plugin, "
"then run its import screen under Tools."
msgstr ""
"Este .zip é um plugin: instale-o em Plugins → Adicionar plugin → Enviar "
"plugin e depois use a tela de importação dele em Ferramentas."

#: includes/bundle-plugin.php:91
