msgstr[1] "%1$d arquivos, %2$s"

#: includes/bundle-plugin.php:611
msgid "Before importing"
msgstr "Antes de importar"

#: includes/bundle-plugin.php:617 includes/bundle-plugin.php:625
msgid "The WordPress Importer is installed."
msgstr "O Importador do WordPress está instalado."

#: includes/bundle-plugin.php:621
msgid "The WordPress Importer is needed."
msgstr "O Importador do WordPress é necessário."

#: includes/bundle-plugin.php:629 includes/bundle-plugin.php:755
msgid "WordPress Importer"
msgstr "Importador do WordPress"

#. translators: 1: file name, 2: size, 3: date.
#: includes/bundle-plugin.php:643
#, php-format
msgid "The bundle: %1$s, %2$s, made %3$s."
msgstr "O pacote: %1$s, %2$s, feito em %3$s."

#: includes/bundle-plugin.php:657 includes/import.php:661
msgid ""
"Update pages, posts and products that already exist (same slug) instead of "
"adding copies"
msgstr ""
"Atualizar páginas, posts e produtos que já existem (mesmo slug) em vez de "
"adicionar cópias"

#: includes/bundle-plugin.php:661
msgid ""
"Importing again finds the same items and doesn’t duplicate them, but "
"settings are set again."
msgstr ""
"Importar de novo encontra os mesmos itens e não os duplica, mas as "
"configurações são definidas de novo."

#: includes/bundle-plugin.php:793
msgid "Sorry, you are not allowed to import."
msgstr "Você não tem permissão para importar."

#: includes/bundle-plugin.php:850
msgid "Sorry, you are not allowed to delete plugins."
msgstr "Você não tem permissão para excluir plugins."

#: includes/bundle.php:541
msgid "The .wxrz bundle is damaged or incomplete."
msgstr "O pacote .wxrz está danificado ou incompleto."

#: includes/bundle.php:596 includes/bundle.php:630
msgid "The content of the .wxrz bundle could not be merged."
msgstr "Não foi possível mesclar o conteúdo do pacote .wxrz."

#: includes/bundle.php:707
msgid "The .wxrz bundle has no valid manifest."
