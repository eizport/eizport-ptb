msgstr ""
"Importado em %s. Desativar e excluir remove este plugin e o arquivo dele."

#: includes/bundle-plugin.php:559
msgid "Also delete (checked: installed for this import)"
msgstr "Também excluir (marcados: instalados para esta importação)"

#: includes/bundle-plugin.php:573
msgid "What it holds"
msgstr "O que ele traz"

#. translators: %d: number of items not listed.
#: includes/bundle-plugin.php:584
#, php-format
msgid " and %d more"
msgstr " e mais %d"

